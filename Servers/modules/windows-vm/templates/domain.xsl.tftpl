<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rendered by Terraform (templatefile) and applied by the libvirt provider to the
  generated domain XML. The dmacvicar/libvirt 0.8 provider has no native CD-ROM or
  boot-order support, so this stylesheet:
    1. Injects the virtualization <features> (acpi/apic/hyperv) required by Windows.
    2. Moves the OS boot disk onto the SATA bus (Windows Setup sees it natively).
    3. Attaches the Windows install DVD and the autounattend answer-file DVD as
       SATA CD-ROMs, with the install DVD as the first boot device.
-->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output omit-xml-declaration="yes" indent="yes"/>

  <!-- Identity transform: copy everything by default. -->
  <xsl:template match="@*|node()">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
    </xsl:copy>
  </xsl:template>

  <!-- Inject <features> before <devices> and append the install/answer CD-ROMs. -->
  <xsl:template match="devices">
    <features>
      <acpi/>
      <apic/>
      <hyperv/>
    </features>
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
%{ if attach_install_media ~}
      <!-- Windows Server installation media (first boot device). -->
      <disk type="file" device="cdrom">
        <driver name="qemu" type="raw"/>
        <source file="${windows_iso}"/>
        <target dev="sdb" bus="sata"/>
        <readonly/>
        <boot order="1"/>
      </disk>
      <!-- Autounattend answer-file media (Windows Setup auto-detects autounattend.xml). -->
      <disk type="file" device="cdrom">
        <driver name="qemu" type="raw"/>
        <source file="${autounattend_iso}"/>
        <target dev="sdc" bus="sata"/>
        <readonly/>
      </disk>
%{ endif ~}
      <!-- USB tablet: gives the console an absolute pointer (no mouse drift or
           offset), matching the VMware Workstation pointer experience. libvirt
           still adds the implicit ps2 mouse/keyboard; the tablet takes over. -->
      <xsl:if test="not(input[@type='tablet'])">
        <input type="tablet" bus="usb"/>
      </xsl:if>
      <!-- QXL video: replaces libvirt's default Cirrus adapter (many more
           resolutions and far better console performance). This must be ADDED
           here rather than matched, because libvirt only injects its default
           <video> when none is present, and it does so AFTER this XSLT runs. -->
      <xsl:if test="not(video)">
        <video>
          <model type="qxl" ram="65536" vram="65536" vgamem="16384" heads="1" primary="yes"/>
        </video>
      </xsl:if>
      <!-- SPICE vdagent channel: enables guest/host clipboard sharing and
           automatic display resizing once spice-vdagent (from the virtio-win /
           spice guest tools) is installed and running inside Windows. -->
      <xsl:if test="not(channel[target/@name='com.redhat.spice.0'])">
        <channel type="spicevmc">
          <target type="virtio" name="com.redhat.spice.0"/>
        </channel>
      </xsl:if>
    </xsl:copy>
  </xsl:template>

  <!-- Put the OS boot disk on the SATA bus. It is the second boot device while
       the install DVD is present, and the first once install media is removed. -->
  <xsl:template match="devices/disk[@device='disk']">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()[not(self::target)]"/>
      <target dev="sda" bus="sata"/>
      <boot order="${attach_install_media ? 2 : 1}"/>
    </xsl:copy>
  </xsl:template>

  <!-- Windows Server has no inbox virtio-net driver, so present an emulated
       Intel e1000e NIC that Windows drives out of the box. -->
  <xsl:template match="interface/model">
    <model type="e1000e"/>
  </xsl:template>

  <!-- If a <video> device is already present before this transform, force it to
       QXL. When none is present, the <devices> template above adds one instead
       (guarded so the two paths never produce a duplicate video device). -->
  <xsl:template match="video">
    <video>
      <xsl:apply-templates select="@*"/>
      <model type="qxl" ram="65536" vram="65536" vgamem="16384" heads="1" primary="yes"/>
    </video>
  </xsl:template>

  <!-- Drop any OS-level <boot> so per-device boot order is authoritative. -->
  <xsl:template match="os/boot"/>
</xsl:stylesheet>
