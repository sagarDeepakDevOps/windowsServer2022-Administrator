<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rendered by Terraform (templatefile) and applied by the libvirt provider to the
  generated network XML. The dmacvicar/libvirt 0.8 provider's dhcp block only
  exposes `enabled`, so this stylesheet injects one <host> static DHCP
  reservation per entry, binding a fixed IP to a MAC (dnsmasq then always hands
  that guest the same address).

  When dns_server is set, it also injects a dnsmasq option (DHCP option 6) via
  libvirt's dnsmasq namespace so every guest is told to use that address as its
  DNS server. This points domain members at the AD DS domain controller.
-->
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:dnsmasq="http://libvirt.org/schemas/network/dnsmasq/1.0"
    exclude-result-prefixes="dnsmasq">
  <xsl:output omit-xml-declaration="yes" indent="yes"/>

  <!-- Identity transform: copy everything by default. -->
  <xsl:template match="@*|node()">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
    </xsl:copy>
  </xsl:template>

  <!-- Append static host reservations inside the existing <dhcp> block. -->
  <xsl:template match="dhcp">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
%{ for r in reservations ~}
      <host mac="${r.mac}" name="${r.hostname}" ip="${r.ip}"/>
%{ endfor ~}
    </xsl:copy>
  </xsl:template>
%{ if dns_server != "" ~}

  <!-- Advertise a custom DNS server to all guests via dnsmasq DHCP option 6. -->
  <xsl:template match="network">
    <xsl:copy>
      <xsl:apply-templates select="@*|node()"/>
      <dnsmasq:options>
        <dnsmasq:option value="dhcp-option=6,${dns_server}"/>
      </dnsmasq:options>
    </xsl:copy>
  </xsl:template>
%{ endif ~}
</xsl:stylesheet>
