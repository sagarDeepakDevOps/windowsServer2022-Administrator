# --- Terraform ---
# Local .terraform directories (provider plugins, modules cache)
**/.terraform/*
**/.terraform

# State files - may contain secrets and are environment-specific
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Variable files that may contain secrets (passwords, tokens).
# Commit sanitized examples as *.tfvars.example instead.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output
*.tfplan

# CLI configuration / credentials
.terraformrc
terraform.rc

# --- Secrets / tokens (NEVER commit these) ---
env.sh
**/env.sh
*.env
.env
secrets.auto.tfvars

# Keep the dependency lock file committed (recommended); do NOT ignore it:
# .terraform.lock.hcl

# --- OS / editor noise ---
.DS_Store
Thumbs.db
